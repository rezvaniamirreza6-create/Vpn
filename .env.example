# توکن ربات از @BotFather
BOT_TOKEN=

# آیدی عددی ادمین(ها) - با کاما جدا کنید برای چند ادمین
ADMIN_IDS=

DATABASE_URL=sqlite:///vpnbot.db

# اطلاعات پنل 3x-ui / Sanaei
PANEL_URL=http://YOUR_SERVER_IP:PANEL_PORT
PANEL_PATH=
PANEL_USERNAME=
PANEL_PASSWORD=

# دامنه‌ای که برای ساخت لینک کانفیگ/ساب استفاده می‌شود
CONFIG_HOST=

# پورت و مسیر سرویس Subscription پنل
SUB_PORT=2096
SUB_PATH=sub

# شماره Inbound (برای چند لوکیشن، با کاما جدا کنید مثلاً 3,9)
INBOUND_IDS=1

# اطلاعات کارت برای پرداخت کارت‌به‌کارت
CARD_NUMBER=
CARD_HOLDER=

BOT_NAME=فروشگاه VPN
SUPPORT_USERNAME=

FREE_TEST_TRAFFIC_GB=1
FREE_TEST_DAYS=1
REFERRAL_REWARD=50000

# فعلاً پیاده‌سازی نشده - خالی بگذارید
ZARINPAL_MERCHANT=

FORCE_JOIN_CHANNELS=
WEBHOOK_URL=
